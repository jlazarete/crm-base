// Fonte única da configuração do Worker. O build (nitro) mescla este arquivo no
// .output/server/wrangler.json. O banco D1 fica declarado SÓ aqui: declarar também no
// vite.config.ts duplicaria o binding, porque o nitro soma as listas.
{
  "name": "crm-base",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crm-base-db",
      "database_id": "dbef8a72-2992-456e-b348-3da36bcc9d44",
      "migrations_dir": "migrations"
    }
  ]
}
